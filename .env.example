# ─────────────────────────────────────────────────────────────
# 知识拼桌 · AI 配置
#
# 用法：把本文件复制成 .env.local（注意是 .local 结尾），填上自己的 key。
#   cp .env.example .env.local
#
# ⚠️ 只改 .env.local，不要改这个文件。.env.local 已被 gitignore，
#    你的 key 不会被提交到仓库。
# ⚠️ 不要用 AI_API_KEY= 的空值 —— 缺 key 会进入"演示模式"（有兜底文案，
#    但不是真 AI 生成），排查问题时请先确认这里填对了。
# ─────────────────────────────────────────────────────────────

# 你的 API 密钥
AI_API_KEY=replace_with_your_key

# OpenAI 兼容接口地址。DeepSeek 用 https://api.deepseek.com
AI_BASE_URL=https://api.deepseek.com

# 模型名。DeepSeek 可用：deepseek-flash（快，本 Demo 用这个）
# 其他 OpenAI 兼容网关请填对应的模型名
AI_MODEL=deepseek-flash
