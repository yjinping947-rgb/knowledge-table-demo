{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      ["feat", "fix", "refactor", "test", "docs", "chore", "style", "perf", "ci", "revert"]
    ],
    "subject-max-length": [2, "always", 30],
    "subject-case": [0],
    "header-max-length": [2, "always", 72]
  }
}
