# .dockerignore
# Docker 构建时排除的路径。未来打 Docker 镜像时用。
# 详见 docs/deployment/cloud.md

# 依赖
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 构建产物
.next/
out/
build/
dist/
*.tsbuildinfo

# 测试
coverage/
.nyc_output/

# 环境变量（绝对不能进镜像）
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example

# Git
.git/
.gitignore
.gitattributes

# 文档（不进运行时）
docs/
*.md
!README.md

# 编辑器 / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Harness 治理（不进运行时，但保留在源码仓库）
.harness/

# CI 配置（不进运行时）
.github/

# 测试 artifacts
test-result.log
verify-round-table.txt
next.log
next.out
next.err
next.pid

# 临时
.tmp/
.mavis-trash/
