{
  "name": "knowledge-table-demo",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "harness:check": "node scripts/harness-check.mjs",
    "check:all": "npm run lint && npm run typecheck && npm run build",
    "test": "node --test tests/*.test.mjs",
    "test:core": "node tests/core-branches.mjs",
    "test:rag": "node tests/rooms-rag.mjs",
    "test:session": "node tests/session-flow.mjs",
    "test:rag-quality": "node tests/rag-quality.mjs",
    "test:all": "node tests/core-branches.mjs && node tests/rooms-rag.mjs && node tests/session-flow.mjs && node tests/rag-quality.mjs",
    "rag:build": "node scripts/collect-corpus-batch.mjs && node scripts/embed-topics.mjs",
    "rag:build-rooms": "node scripts/build-rooms.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "node -e \"const {readFileSync,writeFileSync,statSync}=require('fs');for(const f of process.argv.slice(1)){if(!statSync(f,{throwIfNoEntry:false})?.isFile())continue;try{const c=readFileSync(f,'utf-8');const trimmed=c.replace(/[ \\t]+(?=\\n|$)/g,'').replace(/\\n{3,}/g,'\\n\\n');if(trimmed!==c)writeFileSync(f,trimmed);}catch(e){process.exitCode=0}}\" --"
    ]
  },
  "dependencies": {
    "next": "16.3.4",
    "openai": "6.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.0",
    "@commitlint/config-conventional": "19.6.0",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.37.0",
    "eslint-config-next": "16.3.4",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "typescript": "5.9.3"
  }
}
